# Supabase - когда заполнено, новости/мероприятия читаются из таблицы news
# (схема и наполнение: supabase/migrations/0001_news.sql). Без ключей сайт работает
# на локальном снапшоте lib/news-seed.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Будущий переезд на локальную SQL заказчика (postgres/mysql у ИВС):
# NEWS_DB=local + строка подключения - клиент добавляется в lib/news.ts, схема таблицы та же.
# NEWS_DB=supabase
# DATABASE_URL=
